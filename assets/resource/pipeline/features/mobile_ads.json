{
    "MobileAdTask": {
        "action": "Custom",
        "custom_action": "MobileAdResetStateAction",
        "custom_action_param": {
            "max_cycles": 3
        },
        "next": [
            "MobileAdRouter"
        ]
    },
    "MobileAdRouter": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdVerifyRewardPopup",
            "MobileAdWheelStop",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdEndcard",
            "MobileAdPlaying",
            "MobileAdPlayingByOCR",
            "MobileAdCenter",
            "MobileAdCenterByOCR"
        ]
    },
    "MobileAdCenter": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/看视频赚大奖_入口.png",
        "roi": [
            990,
            500,
            140,
            110
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 2500,
        "timeout": 15000,
        "on_error": ["MobileAdRetryEntryFromCenter"],
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdPlaying",
            "MobileAdPlayingByOCR",
            "MobileAdEndcard"
        ]
    },
    "MobileAdCenterByOCR": {
        "recognition": "OCR",
        "expected": [
            "看视频",
            "赚大奖"
        ],
        "roi": [
            980,
            480,
            160,
            140
        ],
        "action": "Click",
        "post_delay": 2500,
        "timeout": 15000,
        "on_error": ["MobileAdRetryEntryFromCenter"],
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdPlaying",
            "MobileAdPlayingByOCR",
            "MobileAdEndcard"
        ]
    },
    "MobileAdPlaying": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/广告播放中_右上角胶囊.png",
        "roi": [
            1350,
            10,
            240,
            80
        ],
        "threshold": 0.65,
        "action": "Custom",
        "custom_action": "MobileAdOnAdStartAction",
        "timeout": 80000,
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdEndcard"
        ]
    },
    "MobileAdPlayingByOCR": {
        "recognition": "OCR",
        "expected": [
            "获得奖励",
            "广告",
            "安装",
            "跳过"
        ],
        "roi": [
            10,
            10,
            500,
            120
        ],
        "action": "Custom",
        "custom_action": "MobileAdOnAdStartAction",
        "timeout": 80000,
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdEndcard"
        ]
    },
    "MobileAdEndcard": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/广告结束页_关闭.png",
        "roi": [
            1515,
            20,
            75,
            70
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 1500,
        "timeout": 20000,
        "next": [
            "MobileAdPostReturnRouter"
        ]
    },
    "MobileAdRewardedText": {
        "recognition": "OCR",
        "expected": "^恭喜已获得奖励$",
        "roi": [25, 25, 440, 70],
        "action": "DoNothing"
    },
    "MobileAdCapsuleCloseIdentity": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/奖励已获得_胶囊关闭.png",
        "roi": [1480, 30, 60, 60],
        "threshold": 0.8,
        "action": "DoNothing"
    },
    "MobileAdRewardedCapsule": {
        "recognition": "And",
        "all_of": ["MobileAdRewardedText", "MobileAdCapsuleCloseIdentity"],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "MobileAdOnAdStartAction",
        "timeout": 3000,
        "next": ["MobileAdDeviceTimeLimit", "MobileAdDownloadEndcard", "MobileAdEndcard", "MobileAdCloseRewardedCapsule"]
    },
    "MobileAdCloseRewardedCapsule": {
        "recognition": "And",
        "all_of": ["MobileAdRewardedText", "MobileAdCapsuleCloseIdentity"],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "ClickRecognizedCenterAction",
        "post_delay": 1500,
        "timeout": 20000,
        "next": ["MobileAdPostReturnRouter"]
    },
    "MobileAdDeviceTimeLimit": {
        "recognition": "OCR",
        "expected": "今日可用时长已达上限",
        "roi": [480, 300, 650, 150],
        "action": "Custom",
        "custom_action": "FailTaskAction",
        "focus": {"start": "手机看广告：系统今日可用时长已达上限，请检查手机使用时长设置"}
    },
    "MobileAdDownloadText": {
        "recognition": "OCR",
        "expected": "^立即下载$",
        "roi": [650, 470, 300, 90],
        "action": "DoNothing"
    },
    "MobileAdDownloadCloseIdentity": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/下载浮层_关闭.png",
        "roi": [1515, 20, 75, 70],
        "threshold": 0.8,
        "action": "DoNothing"
    },
    "MobileAdDownloadEndcard": {
        "recognition": "And",
        "all_of": ["MobileAdDownloadText", "MobileAdDownloadCloseIdentity"],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "MobileAdOnAdStartAction",
        "timeout": 3000,
        "next": ["MobileAdCloseDownloadEndcard"]
    },
    "MobileAdCloseDownloadEndcard": {
        "recognition": "And",
        "all_of": ["MobileAdDownloadText", "MobileAdDownloadCloseIdentity"],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "ClickRecognizedCenterAction",
        "post_delay": 1500,
        "timeout": 20000,
        "next": ["MobileAdPostReturnRouter"]
    },
    "MobileAdRetryEntryFromCenter": {
        "recognition": "And",
        "all_of": ["MobileAdCenter"],
        "action": "Custom",
        "custom_action": "MobileAdRetryEntryAction",
        "post_delay": 1000,
        "timeout": 3000,
        "next": ["MobileAdCenter", "MobileAdCenterByOCR"]
    },
    "MobileAdPostReturnRouter": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": 20000,
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdWheelStop",
            "MobileAdVerifyRewardPopup"
        ]
    },
    "MobileAdWheelStop": {
        "recognition": "OCR",
        "expected": [
            "^停止$"
        ],
        "roi": [
            980,
            480,
            160,
            140
        ],
        "action": "Click",
        "post_delay": 3500,
        "timeout": 15000,
        "next": [
            "MobileAdWheelStopAgain",
            "MobileAdVerifyRewardPopup"
        ]
    },
    "MobileAdWheelStopAgain": {
        "recognition": "OCR",
        "expected": [
            "^停止$"
        ],
        "roi": [
            980,
            480,
            160,
            140
        ],
        "action": "Click",
        "post_delay": 3500,
        "timeout": 15000,
        "next": [
            "MobileAdWheelStopAgain",
            "MobileAdVerifyRewardPopup"
        ]
    },
    "MobileAdVerifyRewardPopup": {
        "recognition": "OCR",
        "expected": [
            "恭喜你获得如下奖励",
            "要继续观看下一段视频吗",
            "继续观看下一段视频"
        ],
        "roi": [
            600,
            200,
            400,
            280
        ],
        "timeout": 10000,
        "action": "Custom",
        "custom_action": "MobileAdRecordRewardAction",
        "next": [
            "MobileAdCheckContinueCondition",
            "MobileAdClickContinueCheck"
        ]
    },
    "MobileAdCheckContinueCondition": {
        "recognition": "Custom",
        "custom_recognition": "MobileAdCheckCycleLimitReco",
        "custom_recognition_param": {
            "max_cycles": 3
        },
        "action": "DoNothing",
        "next": [
            "MobileAdCloseRewardPopupAndDone"
        ]
    },
    "MobileAdCloseRewardPopupAndDone": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/奖励弹窗_关闭.png",
        "roi": [
            840,
            455,
            100,
            110
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 1500,
        "next": [
            "MobileAdDone"
        ]
    },
    "MobileAdClickContinueCheck": {
        "recognition": "TemplateMatch",
        "template": "mobile_ads/奖励弹窗_继续观看.png",
        "roi": [
            930,
            455,
            120,
            130
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 2000,
        "timeout": 15000,
        "on_error": [
            "MobileAdCenter",
            "MobileAdCenterByOCR"
        ],
        "next": [
            "MobileAdDeviceTimeLimit",
            "MobileAdRewardedCapsule",
            "MobileAdDownloadEndcard",
            "MobileAdPlaying",
            "MobileAdPlayingByOCR",
            "MobileAdEndcard"
        ]
    },
    "MobileAdDone": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    }
}
