{
    "DailyMagicPuzzleTask": {
        "recognition": "TemplateMatch",
        "template": "拼图页面_识别.png",
        "roi": [
            0,
            482,
            316,
            238
        ],
        "threshold": 0.8,
        "action": "DoNothing",
        "timeout": 5000,
        "next": [
            "DailyMagicPuzzleSolve"
        ],
        "on_error": [
            "DailyMagicPuzzlePageAbort"
        ]
    },
    "DailyMagicPuzzleSolve": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "DailyMagicPuzzleSolveAction",
        "custom_action_param": {
            "grid_size": 4,
            "target_size": 2,
            "piece_count": 4,
            "board_size": 4,
            "piece1": 1,
            "piece2": 2,
            "piece3": 5,
            "piece4": 6,
            "duration_ms": 400,
            "move_delay_ms": 600
        },
        "next": [
            "DailyMagicPuzzleDone"
        ],
        "on_error": [
            "DailyMagicPuzzleInvalidInput"
        ]
    },
    "DailyMagicPuzzleDone": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "focus": {
            "Node.Action.Succeeded": "[每日魔幻拼图] 最短 Swipe 序列已执行完成。"
        }
    },
    "DailyMagicPuzzlePageAbort": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": "[每日魔幻拼图] 未识别到拼图页面，已安全停止且未执行 Swipe。"
        }
    },
    "DailyMagicPuzzleInvalidInput": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": "[每日魔幻拼图] 图片块位置无效、重复或求解超出预算，已安全停止且未操作游戏画面。"
        }
    }
}
