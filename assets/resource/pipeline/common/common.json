{
    "StartAppTask": {
        "action": "StartApp",
        "package": "com.happyelements.happyfishandroidcns/com.happyelements.happyfish.MainActivity",
        "post_delay": 2000,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ClickEnterGame",
            "ConfirmMainScreen"
        ]
    },
    "CloseAnnouncement": {
        "recognition": "TemplateMatch",
        "template": "关闭公告.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 300,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ClickEnterGame",
            "ConfirmMainScreen"
        ]
    },
    "ClickEnterGame": {
        "recognition": "TemplateMatch",
        "template": "进入游戏.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 800,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ConfirmMainScreen"
        ]
    },
    "ConfirmMainScreen": {
        "recognition": "TemplateMatch",
        "template": "主界面特征.png",
        "threshold": 0.7,
        "action": "DoNothing"
    },
    "GlobalActivityPagePopup": {
        "recognition": "Or",
        "any_of": ["GlobalDancingFishPopup", "GlobalLuckyMomentTitle", "GlobalActivityPageReturn"],
        "action": "DoNothing",
        "timeout": 4000,
        "next": ["GlobalDancingFishPopup", "GlobalLuckyMomentClose", "GlobalActivityPageReturn"],
        "on_error": ["GlobalActivityPopupFailed"]
    },
    "GlobalDancingFishPopup": {
        "recognition": "OCR",
        "expected": "跳舞鱼可以跳舞了",
        "roi": [480, 290, 460, 100],
        "action": "Custom",
        "custom_action": "CloseDancingFishPopupAction",
        "on_error": ["GlobalActivityPopupFailed"],
        "focus": {"Node.Action.Succeeded": "[巡检弹窗] 已确认跳舞鱼提示，点击红叉关闭。"}
    },
    "GlobalLuckyMomentTitle": {
        "recognition": "OCR",
        "expected": "^幸运时刻$",
        "roi": [400, 0, 470, 125],
        "action": "DoNothing"
    },
    "GlobalLuckyMomentText": {
        "recognition": "OCR",
        "expected": "赌上你的宝石.*挪动杯子",
        "roi": [340, 400, 600, 130],
        "action": "DoNothing"
    },
    "GlobalLuckyMomentIdentity": {
        "recognition": "And",
        "all_of": ["GlobalLuckyMomentTitle", "GlobalLuckyMomentText"],
        "action": "DoNothing"
    },
    "GlobalLuckyMomentClose": {
        "recognition": "OCR",
        "expected": "^幸运时刻$",
        "roi": [400, 0, 470, 125],
        "action": "Custom",
        "custom_action": "CloseLuckyMomentAction",
        "on_error": ["GlobalActivityPopupFailed"],
        "focus": {"Node.Action.Succeeded": "[幸运时刻] 已确认弹窗关闭，继续当前任务。"}
    },
    "GlobalActivityPopupFailed": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "FailTaskAction",
        "focus": {"Node.Action.Failed": "[活动弹窗] ERROR: 页面识别或关闭验证失败，安全停止。"}
    },
    "GlobalActivityPageReturn": {
        "recognition": "TemplateMatch",
        "template": "活动页面_退出.png",
        "roi": [0, 0, 136, 116],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 1000,
        "focus": "检测到活动页面弹出，已点击左上角退出并返回鱼缸，继续当前任务"
    },
    "FriendPageMessageBoxToStarFriends": {
        "recognition": "OCR",
        "expected": "未读留言最多保留",
        "roi": [40, 90, 660, 80],
        "action": "Click",
        "target": [489, 41, 8, 8],
        "post_delay": 1000,
        "timeout": 5000,
        "next": ["FriendPageStarFriendsIdentity"],
        "on_error": ["FriendPageNavigationFailed"],
        "focus": {"Node.Action.Succeeded": "[好友导航] 已确认留言箱，点击星级好友页签并等待列表。"}
    },
    "FriendPageStarFriendsIdentity": {
        "recognition": "OCR",
        "expected": "星级好友",
        "roi": [110, 100, 200, 55],
        "action": "DoNothing"
    },
    "FriendPageNavigationFailed": {
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {"Node.Action.Succeeded": "[好友导航] ERROR: 星级好友列表未确认，安全停止。"}
    },
    "GlobalDailySignPopup": {
        "recognition": "TemplateMatch",
        "template": "签到_识别.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "timeout": 4000,
        "next": [
            "GlobalDailySignAlreadySigned",
            "GlobalDailySignClaim",
            "GlobalDailySignClaimByOcr",
            "GlobalDailySignAutoClosed"
        ],
        "on_error": ["GlobalDailySignFailed"]
    },
    "GlobalDailySignAlreadySigned": {
        "recognition": "OCR",
        "expected": "^已签到$",
        "roi": [0, 400, 1280, 320],
        "action": "DoNothing",
        "timeout": 4000,
        "next": ["GlobalDailySignClose", "GlobalDailySignAutoClosed"],
        "on_error": ["GlobalDailySignFailed"]
    },
    "GlobalDailySignClaim": {
        "recognition": "TemplateMatch",
        "template": "签到_点击.png",
        "threshold": 0.8,
        "roi": [0, 400, 1280, 320],
        "action": "Click",
        "post_delay": 1200,
        "timeout": 4000,
        "focus": "已识别并点击下方签到文字，准备关闭签到弹窗",
        "next": [
            "GlobalDailySignClose",
            "GlobalDailySignAutoClosed"
        ],
        "on_error": [
            "GlobalDailySignFailed"
        ]
    },
    "GlobalDailySignClaimByOcr": {
        "recognition": "OCR",
        "expected": "^签到$",
        "roi": [0, 400, 1280, 320],
        "action": "Click",
        "post_delay": 1200,
        "timeout": 4000,
        "focus": "已通过文字识别点击下方签到，准备关闭签到弹窗",
        "next": [
            "GlobalDailySignClose",
            "GlobalDailySignAutoClosed"
        ],
        "on_error": [
            "GlobalDailySignFailed"
        ]
    },
    "GlobalDailySignClose": {
        "recognition": "TemplateMatch",
        "template": "签到_关闭.png",
        "threshold": 0.75,
        "roi": [1000, 0, 220, 160],
        "action": "Custom",
        "custom_action": "DailySignCloseAction",
        "custom_action_param": {"click_roi": [1084, 45, 41, 43]},
        "post_delay": 0,
        "timeout": 4000,
        "focus": "正在点击签到弹窗关闭按钮并确认页面消失",
        "on_error": ["GlobalDailySignFailed"]
    },
    "GlobalDailySignFailed": {
        "action": "StopTask",
        "focus": "ERROR: 签到弹窗领取或关闭验证失败，已停止任务，避免反复点击"
    },
    "GlobalDailySignAutoClosed": {
        "recognition": "TemplateMatch",
        "template": "签到_识别.png",
        "threshold": 0.8,
        "inverse": true,
        "action": "DoNothing"
    },
    "GlobalSpecialOfferPopup": {
        "recognition": "TemplateMatch",
        "template": "特惠礼包_识别.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "next": [
            "GlobalSpecialOfferClose"
        ]
    },
    "GlobalSpecialOfferClose": {
        "recognition": "TemplateMatch",
        "template": "特惠礼包_关闭.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 500
    },
    "GlobalNewsPopup": {
        "recognition": "OCR",
        "expected": "快报",
        "roi": [
            635,
            23,
            226,
            162
        ],
        "action": "DoNothing",
        "next": [
            "GlobalNewsClose"
        ]
    },
    "GlobalNewsClose": {
        "recognition": "TemplateMatch",
        "template": "快报页面_关闭.png",
        "roi": [
            1044,
            77,
            26,
            31
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 500,
        "focus": "检测到快报页面弹出，已识别并点击关闭，继续当前任务"
    },
    "GlobalLevelUpPopup": {
        "recognition": "TemplateMatch",
        "template": "升级弹窗_识别.png",
        "roi": [
            200,
            348,
            378,
            185
        ],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": [
            "GlobalLevelUpConfirm"
        ]
    },
    "GlobalLevelUpConfirm": {
        "recognition": "OCR",
        "expected": "太好了",
        "roi": [
            957,
            627,
            125,
            47
        ],
        "action": "Click",
        "post_delay": 500,
        "focus": "检测到升级弹窗，已识别并点击“太好了”，继续当前任务"
    }
}
