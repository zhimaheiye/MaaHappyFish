{
    "StartAppTask": {
        "action": "StartApp",
        "package": "com.happyelements.happyfishandroidcns/com.happyelements.happyfish.MainActivity",
        "post_delay": 2000,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ClickEnterGame",
            "ConfirmMainScreen"
        ]
    },
    "CloseAnnouncement": {
        "recognition": "TemplateMatch",
        "template": "关闭公告.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 300,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ClickEnterGame",
            "ConfirmMainScreen"
        ]
    },
    "ClickEnterGame": {
        "recognition": "TemplateMatch",
        "template": "进入游戏.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 800,
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "CloseAnnouncement",
            "ConfirmMainScreen"
        ]
    },
    "ConfirmMainScreen": {
        "recognition": "TemplateMatch",
        "template": "主界面特征.png",
        "threshold": 0.7,
        "action": "DoNothing"
    },
    "DailySignTask": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "[JumpBack]GlobalActivityPagePopup",
            "[JumpBack]GlobalDailySignPopup",
            "[JumpBack]GlobalSpecialOfferPopup",
            "[JumpBack]GlobalNewsPopup",
            "[JumpBack]GlobalLevelUpPopup",
            "DailySignNoPopup"
        ]
    },
    "GlobalActivityPagePopup": {
        "recognition": "TemplateMatch",
        "template": "活动页面_退出.png",
        "roi": [0, 0, 136, 116],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 1000,
        "focus": "检测到活动页面弹出，已点击左上角退出并返回鱼缸，继续当前任务"
    },
    "GlobalDailySignPopup": {
        "recognition": "TemplateMatch",
        "template": "签到_识别.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "next": [
            "GlobalDailySignClaim"
        ]
    },
    "GlobalDailySignClaim": {
        "recognition": "TemplateMatch",
        "template": "签到_点击.png",
        "threshold": 0.8,
        "roi": [0, 400, 1280, 320],
        "action": "Click",
        "post_delay": 1200,
        "timeout": 4000,
        "focus": "已识别并点击下方签到文字，准备关闭签到弹窗",
        "next": [
            "GlobalDailySignClose",
            "GlobalDailySignAutoClosed"
        ],
        "on_error": [
            "GlobalDailySignClaimByOcr"
        ]
    },
    "GlobalDailySignClaimByOcr": {
        "recognition": "OCR",
        "expected": "^签到$",
        "roi": [0, 400, 1280, 320],
        "action": "Click",
        "post_delay": 1200,
        "timeout": 4000,
        "focus": "已通过文字识别点击下方签到，准备关闭签到弹窗",
        "next": [
            "GlobalDailySignClose",
            "GlobalDailySignAutoClosed"
        ],
        "on_error": [
            "GlobalDailySignClose"
        ]
    },
    "GlobalDailySignClose": {
        "recognition": "TemplateMatch",
        "template": "签到_关闭.png",
        "threshold": 0.75,
        "roi": [1000, 0, 220, 160],
        "action": "Click",
        "post_delay": 800,
        "timeout": 4000,
        "focus": "已点击签到弹窗右上角关闭"
    },
    "GlobalDailySignAutoClosed": {
        "recognition": "TemplateMatch",
        "template": "签到_识别.png",
        "threshold": 0.8,
        "inverse": true,
        "action": "DoNothing"
    },
    "GlobalSpecialOfferPopup": {
        "recognition": "TemplateMatch",
        "template": "特惠礼包_识别.png",
        "threshold": 0.8,
        "action": "DoNothing",
        "next": [
            "GlobalSpecialOfferClose"
        ]
    },
    "GlobalSpecialOfferClose": {
        "recognition": "TemplateMatch",
        "template": "特惠礼包_关闭.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 500
    },
    "GlobalNewsPopup": {
        "recognition": "OCR",
        "expected": "快报",
        "roi": [
            635,
            23,
            226,
            162
        ],
        "action": "DoNothing",
        "next": [
            "GlobalNewsClose"
        ]
    },
    "GlobalNewsClose": {
        "recognition": "TemplateMatch",
        "template": "快报页面_关闭.png",
        "roi": [
            1044,
            77,
            26,
            31
        ],
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 500,
        "focus": "检测到快报页面弹出，已识别并点击关闭，继续当前任务"
    },
    "GlobalLevelUpPopup": {
        "recognition": "TemplateMatch",
        "template": "升级弹窗_识别.png",
        "roi": [
            200,
            348,
            378,
            185
        ],
        "threshold": 0.8,
        "action": "DoNothing",
        "next": [
            "GlobalLevelUpConfirm"
        ]
    },
    "GlobalLevelUpConfirm": {
        "recognition": "OCR",
        "expected": "太好了",
        "roi": [
            957,
            627,
            125,
            47
        ],
        "action": "Click",
        "post_delay": 500,
        "focus": "检测到升级弹窗，已识别并点击“太好了”，继续当前任务"
    },
    "DailySignNoPopup": {
        "recognition": "DirectHit",
        "action": "DoNothing"
    }
}
