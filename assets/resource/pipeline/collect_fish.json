{
    "CollectFishTask": {
        "recognition": "Custom",
        "custom_recognition": "CalcFishingFoodReco",
        "custom_recognition_param": {
            "capacity": 100,
            "current_duration": 120,
            "target_hour": 8
        },
        "action": "DoNothing",
        "post_delay": 200,
        "timeout": -1,
        "next": [
            "ResumeHarvest"
        ]
    },
    "ResumeHarvest": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "timeout": -1,
        "next": [
            "HandleCloseAnnouncement",
            "HandleEnterGame",
            "HandleShellPage",
            "CloseFeedPopup",
            "TriggerStarfishFeed",
            "CheckDutyCycle",
            "ClickFishBubble"
        ]
    },
    "HandleCloseAnnouncement": {
        "recognition": "TemplateMatch",
        "template": "关闭公告.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 500,
        "timeout": -1,
        "next": [
            "ResumeHarvest"
        ]
    },
    "HandleEnterGame": {
        "recognition": "TemplateMatch",
        "template": "进入游戏.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 2000,
        "timeout": -1,
        "next": [
            "ResumeHarvest"
        ]
    },
    "ClickFishBubble": {
        "recognition": "TemplateMatch",
        "template": "金币气泡.png",
        "threshold": 0.75,
        "roi": [
            428,
            126,
            679,
            360
        ],
        "action": "Click",
        "post_delay": 100,
        "rate_limit": 200,
        "timeout": -1,
        "next": [
            "ResumeHarvest"
        ],
        "on_error": [
            "ResumeHarvest"
        ]
    },
    "CheckDutyCycle": {
        "recognition": "Custom",
        "custom_recognition": "CheckDutyCycleReco",
        "custom_recognition_param": {
            "idle_interval": 0,
            "active_duration": 120
        },
        "action": "DoNothing",
        "post_delay": 100,
        "timeout": -1,
        "focus": {
            "Node.Recognition.Succeeded": "[巡检收宝] 进入休眠等待，暂停收宝..."
        },
        "next": [
            "HandleCloseAnnouncement",
            "HandleEnterGame",
            "HandleShellPage",
            "CloseFeedPopup",
            "TriggerStarfishFeed",
            "CheckDutyCycle",
            "ResumeHarvest"
        ],
        "on_error": [
            "ResumeHarvest"
        ]
    },
    "TriggerStarfishFeed": {
        "recognition": "Custom",
        "custom_recognition": "CheckStarfishTimerReco",
        "custom_recognition_param": {
            "interval": 600
        },
        "action": "DoNothing",
        "timeout": -1,
        "focus": {
            "Node.Recognition.Succeeded": "[海星喂食] 定时已到，正在触发自动补充鱼食..."
        },
        "next": [
            "OpenSettingsForStarfish"
        ]
    },
