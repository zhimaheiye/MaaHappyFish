{
    "interface_version": 2,
    "name": "MaaHappyFish",
    "label": "开心水族箱小助手",
    "description": "基于 MaaFramework 的开心水族箱自动化日常小助手",
    "version": "0.5.1",
    "github": "https://github.com/zhimaheiye/MaaHappyFish",
    "agent": {
        "child_exec": "python",
        "child_args": [
            "-u",
            "./agent/main.py"
        ]
    },
    "controller": [
        {
            "name": "Android",
            "label": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "Windows",
            "label": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": ".*",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "Default",
            "label": "OPPO服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "StartAppTask",
            "default_check": false,
            "description": "自动启动开心水族箱并等待进入主界面"
        },
        {
            "name": "日常签到",
            "entry": "DailySignTask",
            "default_check": false,
            "description": "自动完成每日签到与领奖"
        },
        {
            "name": "开贝壳",
            "entry": "OpenShellTask",
            "default_check": false,
            "description": "自动连续开贝壳，普通奖励始终继续，遇章鱼固定保留一个随机奖品（请在大章鱼活动主界面开始任务）",
            "option": [
                "开贝壳次数"
            ]
        },
        {
            "name": "好友摸宝",
            "entry": "FriendGemTask",
            "default_check": false,
            "description": "自动巡访好友鱼缸收取金币产物，单好友上限12次，体力耗尽自动跳过（支持在好友列表主界面或任意好友水族箱开始任务）"
        },
        {
            "name": "收鱼产物",
            "entry": "CollectFishTask",
            "default_check": true,
            "description": "在当前单个鱼缸内循环收宝，支持持续运行或按间隔激活，并可定时为当前鱼缸海星喂食",
            "option": [
                "挂机鱼食计算",
                "巡检收宝间隔",
                "喂食间隔"
            ]
        },
        {
            "name": "多鱼缸巡检",
            "entry": "PatrolTask",
            "default_check": false,
            "description": "首轮立即依次巡检 1/2/3 鱼缸收宝并为三缸海星补充鱼食；可选每小时检查魔力召唤和宝石融合",
            "option": [
                "多鱼缸巡检间隔",
                "多鱼缸巡检子任务"
            ]
        },
        {
            "name": "海星喂食(单次)",
            "entry": "FeedStarfishStandalone",
            "default_check": false,
            "description": "单独执行一次：打开设置 -> 识别海星 -> 补充鱼食 -> 返回鱼缸"
        },
        {
            "name": "购买鱼食",
            "entry": "BuyFishFoodTask",
            "default_check": false,
            "description": "使用金币购买指定袋数的廉价鱼食；支持从鱼缸、选择喂食弹窗、商品列表或廉价鱼食详情页安全启动。",
            "option": [
                "购买廉价鱼食袋数"
            ]
        },
        {
            "name": "钓鱼达人",
            "entry": "FishingTask",
            "default_check": false,
            "description": "自动前往指定钓场，选择奶酪鱼饵并完成自动甩杆、咬钩识别、收杆和奖励领取；鱼饵耗尽后自动结束（支持任意中间页面断点续跑）。",
            "option": [
                "钓鱼地点"
            ]
        },
        {
            "name": "海獭摸宝",
            "entry": "SeaOtterGemTask",
            "default_check": false,
            "description": "从海獭寻宝好友列表或好友水族箱开始，在相邻好友间往复切换并自动摸取目标宝石，好友体力耗尽自动向后滑动窗口，陌生人边界安全退出。"
        },
        {
            "name": "乐队鱼演出",
            "entry": "BandFishTask",
            "default_check": false,
            "description": "前往游乐园乐队鱼演出活动，检查并邀请指定好友，完成每日乐章演出（支持在水族箱主界面、游乐园面板或活动界面直接启动）。",
            "option": [
                "乐队鱼乐章"
            ]
        },
        {
            "name": "日常收尾",
            "entry": "DailyRoutineTask",
            "default_check": false,
            "description": "每日收尾总控任务：按序自动执行勾选的日常子任务（每日免费礼包、驯鹿鱼送收礼物、乐队鱼、金海豚、钓鱼达人、浪漫满屋），每个子任务结束后均安全返回主鱼缸。",
            "option": [
                "日常收尾任务",
                "乐队鱼乐章",
                "钓鱼地点"
            ]
        },
        {
            "name": "金海豚小游戏",
            "entry": "GoldenDolphinTask",
            "default_check": false,
            "description": "自动进入游乐园金海豚小游戏，高频抓帧检测并点击掉落的XP经验星奖励，次数耗尽或结束后安全返回鱼缸。"
        }
    ],

    "option": {
        "开贝壳次数": {
            "type": "input",
            "label": "开贝壳次数",
            "description": "完整执行多少轮开贝壳；每轮从大章鱼活动主界面的“立即开始”到结算并返回活动页计为1次",
            "inputs": [
                {
                    "name": "次数",
                    "label": "次数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "OpenShellShouldContinue": {
                    "custom_recognition_param": {
                        "target_count": "{次数}"
                    }
                }
            }
        },
        "挂机鱼食计算": {
            "type": "input",
            "label": "挂机鱼食预算计算",
            "description": "根据海星当前存粮与目标挂机时间，自动计算并提醒所需鱼食量",
            "inputs": [
                {
                    "name": "海星容量",
                    "label": "海星单次容量(粒)",
                    "default": "100",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "当前可用时长",
                    "label": "当前存粮可用时长(分钟)",
                    "default": "120",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                },
                {
                    "name": "目标整点",
                    "label": "计划挂机到几点(0-23整点)",
                    "default": "8",
                    "pipeline_type": "int",
                    "verify": "^([0-9]|1[0-9]|2[0-3])$"
                }
            ],
            "pipeline_override": {
                "CollectFishTask": {
                    "custom_recognition_param": {
                        "capacity": "{海星容量}",
                        "current_duration": "{当前可用时长}",
                        "target_hour": "{目标整点}"
                    }
                }
            }
        },
        "购买廉价鱼食袋数": {
            "type": "input",
            "label": "购买廉价鱼食",
            "description": "每袋含 30 粒鱼食、消耗 400 金币；流程只会购买廉价鱼食",
            "inputs": [
                {
                    "name": "袋数",
                    "label": "购买袋数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d{0,2}$"
                }
            ],
            "pipeline_override": {
                "BuyFishFoodStartAtDetail": {
                    "custom_action_param": {
                        "bags": "{袋数}"
                    }
                },
                "BuyFishFoodPurchaseOnDetail": {
                    "custom_action_param": {
                        "bags": "{袋数}"
                    }
                }
            }
        },
        "巡检收宝间隔": {
            "type": "select",
            "label": "单缸收宝间隔",
            "description": "设置当前单个鱼缸每隔多久激活一次收宝(每次收宝2分钟)；选「持续实时」则不间断收宝",
            "default_case": "持续实时",
            "cases": [
                {
                    "name": "持续实时",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 0,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "30秒(测试用)",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 30,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "1分钟(测试用)",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 60,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 300,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 600,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "15分钟",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 900,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 1200,
                                "active_duration": 120
                            }
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "CheckDutyCycle": {
                            "custom_recognition_param": {
                                "idle_interval": 1800,
                                "active_duration": 120
                            }
                        }
                    }
                }
            ]
        },
        "多鱼缸巡检间隔": {
            "type": "select",
            "label": "多鱼缸巡检间隔",
            "description": "一轮完成三缸收宝与三缸海星喂食；任务启动先立即执行一轮，之后按此间隔循环",
            "default_case": "30分钟",
            "cases": [
                {
                    "name": "30秒(测试用)",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 30
                            }
                        }
                    }
                },
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 300
                            }
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 600
                            }
                        }
                    }
                },
                {
                    "name": "15分钟",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 900
                            }
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 1200
                            }
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 1800
                            }
                        }
                    }
                },
                {
                    "name": "1小时",
                    "pipeline_override": {
                        "PatrolTimerDue": {
                            "custom_recognition_param": {
                                "interval": 3600
                            }
                        }
                    }
                }
            ]
        },
        "多鱼缸巡检子任务": {
            "type": "checkbox",
            "label": "每小时巡检子任务",
            "description": "可选任务每小时检查一次；时间重合时固定按三缸收宝喂食、魔力召唤、宝石融合的顺序执行",
            "default_case": [],
            "cases": [
                {
                    "name": "魔力召唤",
                    "pipeline_override": {
                        "PatrolMagicSummonDue": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "宝石融合",
                    "pipeline_override": {
                        "PatrolGemFusionDue": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "喂食间隔": {
            "type": "select",
            "label": "海星喂食间隔",
            "description": "设置每隔多久为海星集中补充一次鱼食；任务启动后会先立即补充一次",
            "default_case": "10分钟",
            "cases": [
                {
                    "name": "30秒(测试用)",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 30
                            }
                        }
                    }
                },
                {
                    "name": "1分钟",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 60
                            }
                        }
                    }
                },
                {
                    "name": "5分钟",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 300
                            }
                        }
                    }
                },
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 600
                            }
                        }
                    }
                },
                {
                    "name": "15分钟",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 900
                            }
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": 1800
                            }
                        }
                    }
                },
                {
                    "name": "不喂食",
                    "pipeline_override": {
                        "TriggerStarfishFeed": {
                            "custom_recognition_param": {
                                "interval": -1
                            }
                        }
                    }
                }
            ]
        },
        "钓鱼地点": {
            "type": "select",
            "label": "目标钓鱼地点",
            "description": "选择需要前往的钓鱼场景地点",
            "default_case": "星河",
            "cases": [
                {
                    "name": "星河",
                    "pipeline_override": {
                        "FishingLocationRouter": {
                            "next": [
                                "FishingSelectLocation_Xinghe"
                            ]
                        }
                    }
                },
                {
                    "name": "冰川",
                    "pipeline_override": {
                        "FishingLocationRouter": {
                            "next": [
                                "FishingSelectLocation_Bingchuan"
                            ]
                        }
                    }
                },
                {
                    "name": "宫殿温泉",
                    "pipeline_override": {
